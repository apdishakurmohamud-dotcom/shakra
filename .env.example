# ==========================================
# TECHNICAL & STORE - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Environment Mode: development / production
NODE_ENV=development

# JWT Secret for Admin Authentication
JWT_SECRET=tech_store_super_secure_secret_key_2026_jwt_token_auth

# JWT Token Expiry (e.g. 24h, 7d)
JWT_EXPIRE=24h

# Database Configuration
# Supported: mysql / sqlite / json
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=technical_store

# WhatsApp Business Configuration (Default fallback)
# Use international format with country code and without '+' or spaces (e.g. 15551234567)
DEFAULT_WHATSAPP_NUMBER=15551234567

# Business Details Defaults
DEFAULT_BUSINESS_NAME=TECHNICAL & STORE
DEFAULT_CURRENCY=$
DEFAULT_SHIPPING_FEE=15.00
DEFAULT_FREE_SHIPPING_MIN=150.00
